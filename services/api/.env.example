# Copy to .env (never commit .env). All values optional for local dev.
DATABASE_URL=jdbc:postgresql://localhost:5432/gitapath
DATABASE_USER=postgres
DATABASE_PASSWORD=
# Clerk: https://dashboard.clerk.com → API Keys → "Frontend API URL"
CLERK_ISSUER=
# Shared secrets for webhooks (pick any long random string)
CMS_WEBHOOK_SECRET=dev-cms-secret
REVENUECAT_WEBHOOK_SECRET=dev-rc-secret
# Optional OpenAI-compatible LLM for the Guide (template answers if blank)
GUIDE_LLM_URL=
GUIDE_LLM_KEY=
GUIDE_LLM_MODEL=
