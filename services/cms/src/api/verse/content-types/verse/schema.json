{
  "kind": "collectionType",
  "collectionName": "verses",
  "info": {
    "singularName": "verse",
    "pluralName": "verses",
    "displayName": "Verse",
    "description": "One Bhagavad Gita verse. The Sanskrit is locked once published: changing it needs scholar approval."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "verse_id": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^\\d{1,2}\\.\\d{1,2}$"
    },
    "chapter": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 18
    },
    "number": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 78
    },
    "sanskrit": {
      "type": "json",
      "required": true
    },
    "iast": {
      "type": "text",
      "required": true
    },
    "meaning": {
      "type": "text",
      "required": true
    },
    "life_note": {
      "type": "text",
      "required": true
    },
    "words": {
      "type": "json"
    },
    "themes": {
      "type": "json"
    },
    "actions": {
      "type": "json"
    },
    "audio_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "translations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::translation.translation",
      "mappedBy": "verse"
    },
    "review_status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "in_review",
        "changes_requested",
        "approved"
      ],
      "default": "draft",
      "required": true
    },
    "reviewer": {
      "type": "string"
    },
    "review_note": {
      "type": "text"
    },
    "sanskrit_change_approved": {
      "type": "boolean",
      "default": false,
      "private": true
    }
  }
}
