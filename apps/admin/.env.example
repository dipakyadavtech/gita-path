# Copy to .env (never commit .env). Empty values use the dev defaults.
VITE_API_URL=http://localhost:8080
# Strapi admin, used for "Edit in Strapi" links
VITE_CMS_URL=http://localhost:1337
# Clerk sign-in for staff (empty = dev sign-in, OTP 123456). Staff need their Clerk user id in the API's ADMIN_USERS.
VITE_CLERK_PUBLISHABLE_KEY=
