  "episodes": {
    "k1": {
      "shlokaId": "ks-4.7",
      "moral": "Telling the truth, even when it's hard, makes everyone trust you more.",
      "talkAbout": "Ask: Why do you think Krishna shared the butter with his friends and the calves?",
      "captions": [
        {
          "at": 0,
          "hi": "गोकुल में सुबह हुई।",
          "en": "Morning came to the village of Gokul."
        },
        {
          "at": 0.2,
          "hi": "माखन की मटकी ऊँची टँगी थी।",
          "en": "The butter pot hung high up on a rope."
        },
        {
          "at": 0.4,
          "hi": "कृष्ण और दोस्तों ने मिलकर सीढ़ी बनाई।",
          "en": "Krishna and his friends made a ladder together."
        },
        {
          "at": 0.6,
          "hi": "माखन सबने बाँटकर खाया — बछड़ों ने भी!",
          "en": "Everyone shared the butter — even the calves!"
        },
        {
          "at": 0.8,
          "hi": "माँ यशोदा ने पूछा, तो कृष्ण ने सच बताया।",
          "en": "When Mother Yashoda asked, Krishna told the truth."
        }
      ]
    },
    "k2": {
      "shlokaId": "ks-4.7",
      "moral": "When we work together, we can carry even a mountain.",
      "talkAbout": "Ask: Who helps you when things feel too heavy?",
      "captions": [
        {
          "at": 0,
          "hi": "आसमान में काले बादल छा गए।",
          "en": "Dark clouds filled the sky."
        },
        {
          "at": 0.25,
          "hi": "तेज़ बारिश से सब डर गए।",
          "en": "Heavy rain made everyone afraid."
        },
        {
          "at": 0.5,
          "hi": "कृष्ण ने गोवर्धन पर्वत उठा लिया।",
          "en": "Krishna lifted Govardhan Hill like an umbrella."
        },
        {
          "at": 0.75,
          "hi": "सबने अपनी लाठी लगाकर मदद की।",
          "en": "Everyone held up their sticks to help."
        }
      ]
    },
    "k3": {
      "shlokaId": "ks-6.5",
      "moral": "Being brave means staying calm and kind, even when you feel scared.",
      "talkAbout": "Ask: What helps you feel brave?",
      "captions": [
        {
          "at": 0,
          "hi": "यमुना का पानी काला हो गया था।",
          "en": "The Yamuna river had turned dark."
        },
        {
          "at": 0.3,
          "hi": "कृष्ण शांत मन से नदी में उतरे।",
          "en": "Krishna stepped into the river with a calm heart."
        },
        {
          "at": 0.6,
          "hi": "उन्होंने कालिया को दयालु बनने को कहा।",
          "en": "He asked Kaliya to be gentle and leave in peace."
        },
        {
          "at": 0.85,
          "hi": "नदी फिर से साफ़ और नीली हो गई।",
          "en": "The river became clean and blue again."
        }
      ]
    }
  },
