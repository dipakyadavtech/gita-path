# Copy to .env and fill in. Never commit .env.
# Leave a value empty to use the built-in dev/demo version of that feature.

# Spring Boot API base URL, e.g. http://192.168.1.10:8080 (empty = demo mode, data stays on the phone)
EXPO_PUBLIC_API_URL=

# Clerk sign-in (empty = dev sign-in, OTP is always 123456)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (empty = subscriptions are simulated)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
